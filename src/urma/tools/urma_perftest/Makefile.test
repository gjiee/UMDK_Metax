#
# 文件: Makefile.test
#
# 最小化单元测试: 仅依赖 libc + perftest_gpu_alloc.c, 不需要 cmake / urma /
# 内核头 / CUDA / ROCm. 跑法:
#
#   $ make -f Makefile.test
#   $ ./perftest_gpu_alloc_test
#
# 退出码 0 = ALL PASS. ASAN 模式:
#   $ make -f Makefile.test CFLAGS_EXTRA="-fsanitize=address -fno-omit-frame-pointer"

CC          ?= gcc
CFLAGS      ?= -O2 -g -Wall -Wextra -std=c99 -D_GNU_SOURCE
CFLAGS_EXTRA ?=
LDFLAGS     ?= -ldl

TEST_BIN := perftest_gpu_alloc_test
SRCS     := perftest_gpu_alloc.c perftest_gpu_alloc_test.c

.PHONY: all clean run

all: $(TEST_BIN)

$(TEST_BIN): $(SRCS) perftest_gpu_alloc.h
	$(CC) $(CFLAGS) $(CFLAGS_EXTRA) -o $@ $(SRCS) $(LDFLAGS)

run: $(TEST_BIN)
	./$(TEST_BIN)

clean:
	rm -f $(TEST_BIN)
