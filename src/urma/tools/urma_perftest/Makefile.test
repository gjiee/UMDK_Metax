#
# Minimal unit test (libc + dl only):
#   make -f Makefile.test && ./perftest_gpu_alloc_test
# Optional GPU diagnostics (off by default in CMake too):
#   make -f Makefile.test CFLAGS_EXTRA="-DPERFTEST_ENABLE_GPU_DEBUG=1"

CC          ?= gcc
CFLAGS      ?= -O2 -g -Wall -Wextra -std=c99 -D_GNU_SOURCE
CFLAGS_EXTRA ?=
URMA_INC    := -I../../lib/urma/core/include
LDFLAGS     ?= -ldl

TEST_BIN := perftest_gpu_alloc_test
SRCS     := perftest_gpu_alloc.c perftest_cuda_loader.c \
            perftest_gdrcopy_loader.c perftest_gpu_alloc_test.c \
            ../../lib/urma/core/urma_gpu_vendor.c

.PHONY: all clean run

all: $(TEST_BIN)

$(TEST_BIN): $(SRCS) perftest_gpu_alloc.h
	$(CC) $(CFLAGS) $(CFLAGS_EXTRA) $(URMA_INC) -o $@ $(SRCS) $(LDFLAGS)

run: $(TEST_BIN)
	./$(TEST_BIN)

clean:
	rm -f $(TEST_BIN)
